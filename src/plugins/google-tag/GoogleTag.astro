---
/**
 * GoogleTag.astro - Plugin Google Tag (unified)
 *
 * Le googleTag.tags[] de pluginsConfig.json (array de IDs).
 * Compatibilidade com chaves antigas:
 *   - googleAnalytics.measurementId
 *   - googleTagManager.containerId
 *
 * G-/AW-/DC-  -> gtag.js servido no HTML (detectavel no codigo-fonte e no Tag Assistant),
 *                com Google Consent Mode v2: tudo negado por padrao e liberado
 *                quando o visitante aceita os cookies.
 * GTM-*       -> gtm.js carregado no head + noscript, liberado com o mesmo consentimento.
 */
import { readData } from '../../lib/readData';

const pluginsConfig = readData('pluginsConfig.json', {}) as any;

const newTags: string[] = pluginsConfig?.googleTag?.tags || [];
const legacyGA: string = pluginsConfig?.googleAnalytics?.measurementId || '';
const legacyGTM: string = pluginsConfig?.googleTagManager?.containerId || '';

const allTags = [...new Set([...newTags, ...(legacyGA ? [legacyGA] : []), ...(legacyGTM ? [legacyGTM] : [])])];
const gtagIds = allTags.filter((id) => id && !id.startsWith('GTM-'));
const gtmIds = allTags.filter((id) => id && id.startsWith('GTM-'));

const requireConsent: boolean = pluginsConfig?.cookieConsent?.enabled !== false;

// Snippet inline: define dataLayer/gtag, aplica o consentimento padrao e configura cada ID.
// Precisa vir ANTES do gtag.js para o Consent Mode valer na primeira pagina vista.
const consentDefault = requireConsent
  ? "gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',wait_for_update:500});"
  : '';
const gtagConfig = gtagIds.map((id) => "gtag('config','" + id + "');").join('');
const gtagInline =
  'window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;' +
  consentDefault +
  "gtag('js',new Date());" +
  gtagConfig;

// Ao aceitar os cookies, libera a coleta (quem ja aceitou antes cai no caminho sincrono).
const consentUpdate = requireConsent
  ? "(function(){function grant(){try{window.gtag('consent','update',{ad_storage:'granted',ad_user_data:'granted',ad_personalization:'granted',analytics_storage:'granted'});}catch(e){}}" +
    "try{if(localStorage.getItem('cookies-accepted')==='true'){grant();}else{window.addEventListener('cookies-accepted',grant,{once:true});}}catch(e){}})();"
  : '';

// GTM: carregado sempre no head; a coleta tambem respeita o consentimento.
const gtmInline = (id: string) =>
  '(function(w,d,i){w.dataLayer=w.dataLayer||[];' +
  "w.dataLayer.push({'gtm.start':new Date().getTime(),event:'gtm.js'});" +
  "var f=d.getElementsByTagName('script')[0],j=d.createElement('script');" +
  "j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i;f.parentNode.insertBefore(j,f);" +
  "d.addEventListener('DOMContentLoaded',function(){var n=d.createElement('noscript'),fr=d.createElement('iframe');" +
  "fr.src='https://www.googletagmanager.com/ns.html?id='+i;fr.height='0';fr.width='0';" +
  "fr.style.display='none';fr.style.visibility='hidden';n.appendChild(fr);d.body.insertBefore(n,d.body.firstChild);});" +
  "})(window,document,'" + id + "');";
---

{gtagIds.length > 0 && (
  <>
    <script is:inline set:html={gtagInline} />
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gtagIds[0]}`}></script>
    {requireConsent && <script is:inline set:html={consentUpdate} />}
  </>
)}

{gtmIds.length > 0 && (
  <script is:inline set:html={gtmIds.map((id) => gtmInline(id)).join('')} />
)}
